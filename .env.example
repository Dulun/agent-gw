# Copy to .env and edit. setup.sh renders gw-data/config.yaml from .env.
# Local loopback API password (setup.sh auto-generates a random value on first run)
API_SECRET=
# Fixed egress for agent-vm: subscription link OR node YAML fragment (fill either one)
# Subscription mode: setup.sh fetches it and merges only the proxies section
PROXY_PROVIDER_URL=
# Static mode: paste node YAML list into nodes.yaml (gitignored), setup.sh merges it
NODES_FILE=nodes.yaml
# Default exit: node name, or empty = first proxy. Panel switches it live.
EXIT_NODE=
# Private key the panel uses to probe the guest (must be one of SSH_PUBKEYS)
PANEL_SSH_KEY=/home/you/.ssh/id_ed25519
# Optional: tailscale one-shot auth key for the guest (see vm.env.example)
# TS_AUTHKEY=tskey-auth-...
# Ports (just avoid the desktop clash ones)
MIXED_PORT=11095
CTRL_PORT=11098
DNS_PORT=1053
PANEL_PORT=11088
# panel has no auth: keep it on loopback unless you put it behind a proxy
PANEL_BIND=127.0.0.1
SSH_PORT=2222
TUN_DEV=tun-gw
TUN_ADDR=198.19.0.1/30
FAKE_IP_RANGE=198.20.0.0/16
EXIT_GROUP=EXIT
# guest identity (route script / nft match on these)
VM_IP=192.168.122.200
VM_MAC=52:54:00:aa:11:01
# physical NIC (node routes are pinned through it; the guest never uses it)
HOME_IF=wlp6s0
BRIDGE=virbr0
TABLE=200
# host proxy: cache misses (verdaccio/registry/apt) fetch upstream through this
HOST_PROXY=http://127.0.0.1:7897
# cache data root (survives rebuilds; copy from another host to skip warming)
CACHE_ROOT=/srv/ci-cache
# images: setup-cache.sh pulls via HOST_PROXY; if the registry is unreachable,
# copy with: ssh <oldhost> "docker save <img>" | docker load  (then docker tag <id> <name>)
# compose uses mutable tags; digests are pinned in comments in cache/compose.yaml
