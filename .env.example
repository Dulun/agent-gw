# Copy to .env and edit. setup.sh renders gw-data/config.yaml from .env.
# Local loopback API password (setup.sh auto-generates a random value on first run)
API_SECRET=
# Fixed egress for agent-vm: subscription link OR node YAML fragment (fill either one)
# Subscription mode: setup.sh fetches it and merges only the proxies section
PROXY_PROVIDER_URL=
# Static mode: paste node YAML list into nodes.yaml (gitignored), setup.sh merges it
NODES_FILE=nodes.yaml
# Default exit: node name, or empty = first proxy. Panel switches it live.
EXIT_NODE=
# Ports (just avoid the desktop clash ones)
MIXED_PORT=11095
CTRL_PORT=11098
DNS_PORT=1053
PANEL_PORT=11088
SSH_PORT=2222
TUN_DEV=tun-gw
TUN_ADDR=198.19.0.1/30
FAKE_IP_RANGE=198.20.0.0/16
EXIT_GROUP=EXIT
# guest identity (route script / nft match on these)
VM_IP=192.168.122.200
VM_MAC=52:54:00:aa:11:01
# home LAN (stays on the physical NIC, never enters the tunnel)
HOME_CIDR=192.168.0.0/24
HOME_IF=wlp6s0
BRIDGE=virbr0
TABLE=200
