# KVM guest for agent-vm. The golden image is private (large, per-machine);
# bring your own qcow2 (agent-vm-golden.qcow2 or kvm-gha-slim-*.qcow2) and set GOLDEN_IMAGE.
# GOLDEN_IMAGE path (host file, read-only backing). Keep it outside the repo.
GOLDEN_IMAGE=
# VM sizing
VM_NAME=agent-vm-xlarge
VM_MEM_MB=16384
VM_VCPUS=16
# Overlay + seed live in the libvirt pool
VM_POOL_DIR=/var/lib/libvirt/images
# Keep the guest clock on the host zone; UTC skew breaks logs and TLS.
VM_TZ=America/Los_Angeles
# SSH keys injected via cloud-init (space-separated .pub files)
SSH_PUBKEYS=~/.ssh/id_ed25519.pub
# tailscale in the guest (optional):
# TS_HOSTNAME empty = skip. Set + TS_AUTHKEY (one-shot key from admin console -> Settings -> Keys)
# to auto-join on first boot; key is used once by cloud-init, never stored in the guest.
TS_HOSTNAME=
# TS_AUTHKEY=tskey-auth-...
