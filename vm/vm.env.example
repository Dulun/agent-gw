# KVM guest for agent-vm. The golden image is private (large, per-machine);
# bring your own qcow2 (agent-vm-golden.qcow2 or kvm-gha-slim-*.qcow2) and set GOLDEN_IMAGE.
# GOLDEN_IMAGE path (host file, read-only backing). Keep it outside the repo.
GOLDEN_IMAGE=
# VM sizing
VM_NAME=agent-vm
VM_MEM_MB=8192
VM_VCPUS=8
# Overlay + seed live in the libvirt pool
VM_POOL_DIR=/var/lib/libvirt/images
# SSH keys injected via cloud-init (space-separated .pub files)
SSH_PUBKEYS=~/.ssh/id_ed25519.pub
